<%- include('../partials/header') %>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clipboard-check"></i> Gestão de Tarefas</h2>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus-circle"></i> Nova Tarefa
        </button>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">            <div class="table-responsive">
                <table class="table table-hover mb-0" id="tasksTable">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Descrição</th>
                            <th>Data de Início</th>
                            <th>Deadline</th>
                            <th>Funcionário Atribuído</th>
                            <th>Tipo de Tarefa</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="tasksTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addTaskModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">
                    <i class="bi bi-clipboard-plus"></i> Nova Tarefa
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>            <div class="modal-body">
                <form id="taskForm">
                    <input type="hidden" id="taskId">
                    <div class="mb-3">
                        <label class="form-label">Descrição</label>
                        <textarea class="form-control" id="task_description" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data de Início</label>
                        <input type="date" class="form-control" id="init_date" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Deadline</label>
                        <input type="date" class="form-control" id="due_date" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Funcionário Responsável</label>
                        <select class="form-select" id="emp_id" required>
                            <option value="">Selecione um funcionário</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de tarefa</label>
                        <select class="form-select" id="task_type" required>
                            <option value="">Selecione o tipo</option>
                            <option value="Compra">Compra</option>
                            <option value="Serviço">Serviço</option>
                            <option value="Cotação">Cotação</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="saveTask">
                    <i class="bi bi-check-circle"></i> Salvar
                </button>
            </div>        </div>
    </div>
</div>

<script src="/js/api.js"></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    loadTasks();
    loadEmployeesForSelect();
    
    document.getElementById('saveTask').addEventListener('click', saveTask);
});

async function loadTasks() {
    try {
        const tasks = await TaskAPI.get('/task');
        displayTasks(tasks);
    } catch (error) {
        console.error('Erro ao carregar tarefas:', error);
        alert('Erro ao carregar tarefas. Verifique se o servidor está rodando.');
    }
}

async function loadEmployeesForSelect() {
    try {
        const employees = await TaskAPI.get('/employee');
        const select = document.getElementById('emp_id');
        
        select.innerHTML = '<option value="">Selecione um funcionário</option>';
        
        employees.forEach(employee => {
            const option = document.createElement('option');
            option.value = employee.emp_id;
            option.textContent = employee.name;
            select.appendChild(option);
        });
    } catch (error) {
        console.error('Erro ao carregar funcionários:', error);
    }
}

function displayTasks(tasks) {
    const tbody = document.getElementById('tasksTableBody');
    tbody.innerHTML = '';
    
    tasks.forEach(task => {
        const row = `
            <tr>
                <td>${task.task_id || ''}</td>
                <td>${task.task_description || ''}</td>
                <td>${task.init_date ? new Date(task.init_date).toLocaleDateString('pt-BR') : ''}</td>
                <td>${task.due_date ? new Date(task.due_date).toLocaleDateString('pt-BR') : ''}</td>
                <td>${task.employee_name || 'Não atribuído'}</td>
                <td>${task.task_type || ''}</td>
                <td class="text-end">
                    <button class="btn btn-sm btn-outline-primary me-2" onclick="editTask(${task.task_id})">
                        <i class="bi bi-pencil"></i>
                    </button>
                    <button class="btn btn-sm btn-outline-danger" onclick="deleteTask(${task.task_id})">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            </tr>
        `;
        tbody.innerHTML += row;
    });
}

async function saveTask() {
    const taskData = {
        task_description: document.getElementById('task_description').value,
        init_date: document.getElementById('init_date').value,
        due_date: document.getElementById('due_date').value,
        emp_id: document.getElementById('emp_id').value || null,
        task_type: document.getElementById('task_type').value
    };
    
    try {
        await TaskAPI.post('/task', taskData);
        loadTasks();
        
        const modal = bootstrap.Modal.getInstance(document.getElementById('addTaskModal'));
        modal.hide();
        document.getElementById('taskForm').reset();
        
        alert('Tarefa criada com sucesso!');
    } catch (error) {
        console.error('Erro ao salvar tarefa:', error);
        alert('Erro ao salvar tarefa. Verifique os dados e tente novamente.');
    }
}

async function deleteTask(id) {
    if (confirm('Tem certeza que deseja excluir esta tarefa?')) {
        try {
            await TaskAPI.delete(`/task/${id}`);
            loadTasks();
            alert('Tarefa excluída com sucesso!');
        } catch (error) {
            console.error('Erro ao excluir tarefa:', error);
            alert('Erro ao excluir tarefa.');
        }
    }
}
